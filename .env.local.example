# ---- Новое (часть 2 брифа) ----

# Service role key из Supabase (Settings -> API -> service_role) —
# СЕКРЕТНЫЙ, не должен начинаться с NEXT_PUBLIC_, используется только
# на сервере (админка). Никогда никому не показывайте этот ключ.
SUPABASE_SERVICE_ROLE_KEY=

# Пароль для входа в /admin — придумайте свой
ADMIN_PASSWORD=

# Brevo — для OTP-писем
BREVO_API_KEY=
BREVO_FROM_EMAIL=ars2007dm@gmail.com
# Получатель служебных уведомлений об успешных входах
LOGIN_NOTIFY_EMAIL=support@fsmo-olimp.ru

# Resend (https://resend.com) — для писем о новых заявках на доступ
RESEND_API_KEY=
RESEND_FROM_EMAIL="ФСМО <auth@fsmo-olimp.ru>"
ADMIN_EMAIL=

# Anthropic API (https://console.anthropic.com) — для ИИ-проверки домашних заданий
ANTHROPIC_API_KEY=

# Telegram-бот для приёма домашних заданий от преподавателей
# Токен от @BotFather. Только серверная переменная, без NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=
# Случайная строка из A-Z, a-z, 0-9, _ и -; передаётся Telegram при setWebhook.
TELEGRAM_WEBHOOK_SECRET=
# ID личного чата администратора или закрытой админ-группы (у группы начинается с -100).
TELEGRAM_ADMIN_CHAT_ID=
# Разрешённые Telegram user_id преподавателей через запятую.
TELEGRAM_ALLOWED_TEACHER_IDS=
